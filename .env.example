# ==================== Database ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=isaralert
DB_USERNAME=isaralert
DB_PASSWORD=isaralert_dev_password

# ==================== Telegram Bot ====================
# Get your bot token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here

# ==================== Scraper Settings ====================
# How often to scan, as a Spring cron expression (sec min hour day month weekday)
# Default: every 5 minutes. Please don't go much lower — be respectful to WG-Gesucht.
SCRAPER_CRON="0 */5 * * * *"
# Delay between HTTP requests in milliseconds (be respectful!)
SCRAPER_REQUEST_DELAY_MS=3000
